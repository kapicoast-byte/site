# There is no DATABASE_URL. Content lives in Firestore, reached with the
# service-account credential below — there is no second database to provision.

# ---- Admin login ------------------------------------------------------------
# The single account that can sign in at /admin. Firebase Authentication holds
# the actual password now — this app never stores or sees it — so there is no
# ADMIN_PASSWORD or SESSION_SECRET here anymore. ADMIN_EMAIL is still needed:
# it is the allowlist that stops any *other* account in the Firebase project
# from being able to sign in here.
#
# Create or change the password with:  node scripts/set-admin-user.mjs
ADMIN_EMAIL="you@example.com"

# ---- Uploads --------------------------------------------------------------
# Absolute path inside the container. Mount a Dokploy volume here so images
# survive redeploys. Used only as the fallback when Firebase Storage below is
# not configured.
UPLOAD_DIR="/app/uploads"

# Public address of the site, used to build absolute URLs in sitemap.xml,
# robots.txt and llms.txt. Without it those files advertise localhost.
SITE_URL=https://kapicoast.in

# --- Firebase --------------------------------------------------------------
# Server-side only. The browser SDK is never used, so nothing Firebase-related
# reaches the JavaScript bundle — not the service account, not the API key.
#
# FIREBASE_SERVICE_ACCOUNT is the service-account JSON, base64-encoded — the
# private key contains newlines and every env-var UI mangles those differently.
#   Linux/macOS : base64 -w0 service-account.json
#   PowerShell  : [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Required — both admin login and (if configured) Storage need it.
FIREBASE_SERVICE_ACCOUNT=

# FIREBASE_WEB_API_KEY is a project identifier, not a secret — the same value
# a client SDK would ship publicly. Used here to check a password against
# Identity Toolkit from the server. Find it in Firebase Console -> Project
# settings -> General -> Web API Key. Required for login.
FIREBASE_WEB_API_KEY=

# FIREBASE_STORAGE_BUCKET is optional. Set it and uploads go to a private
# Storage bucket; leave it unset and uploads fall back to the local disk at
# UPLOAD_DIR.
FIREBASE_STORAGE_BUCKET=
