# ---- Database -------------------------------------------------------------
# Dokploy: create a Postgres service, then paste its internal connection string.
DATABASE_URL="postgresql://kapi:kapi@localhost:5432/kapicoast?schema=public"

# ---- Admin login ----------------------------------------------------------
# The single account that can sign in at /admin.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-this-to-something-long"

# ---- Session --------------------------------------------------------------
# Signs the login cookie. Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-with-32-plus-random-characters"

# ---- Uploads --------------------------------------------------------------
# Absolute path inside the container. Mount a Dokploy volume here so images
# survive redeploys.
UPLOAD_DIR="/app/uploads"

# Public address of the site, used to build absolute URLs in sitemap.xml,
# robots.txt and llms.txt. Without it those files advertise localhost.
SITE_URL=https://kapicoast.in

# --- Firebase Storage (optional) -------------------------------------------
# Server-side only. The browser SDK is never used, so nothing Firebase-related
# reaches the JavaScript bundle and the bucket can stay completely private.
#
# FIREBASE_SERVICE_ACCOUNT is the service-account JSON, base64-encoded — the
# private key contains newlines and every env-var UI mangles those differently.
#   Linux/macOS : base64 -w0 service-account.json
#   PowerShell  : [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#
# Leave both unset and uploads fall back to the local disk at UPLOAD_DIR.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
