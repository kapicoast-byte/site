{
  "name": "kapi-coast",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "prisma generate && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:studio": "prisma studio",
    "db:start": "node scripts/test-db.mjs start",
    "db:stop": "node scripts/test-db.mjs stop",
    "setup": "prisma db push --skip-generate && node prisma/seed.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "firebase-admin": "^14.2.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  }
}
